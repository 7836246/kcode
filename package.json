{
  "name": "kcode",
  "version": "0.0.3",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev:web": "concurrently -k -n server,web -c blue,green \"pnpm --filter @kcode/server dev\" \"pnpm --filter @kcode/web dev\"",
    "dev:website": "pnpm --filter @kcode/website dev",
    "build:website": "pnpm --filter @kcode/website build",
    "dev:desktop": "pnpm run dev:desktop:prod",
    "dev:desktop:test": "node scripts/dev-desktop-env.mjs test",
    "dev:desktop:prod": "node scripts/dev-desktop-env.mjs production",
    "dev:desktop:bytecode": "node scripts/dev-desktop-env.mjs production --agent-bytecode",
    "dev:desktop:remote-prod": "node scripts/dev-desktop-remote-prod.mjs",
    "dev:server": "pnpm --filter @kcode/server dev",
    "prepare": "husky",
    "prepare:desktop-runtime": "pnpm --filter @kcode/desktop prepare:runtime-assets",
    "dep:graph": "node scripts/dependency-graph.mjs",
    "dep:refs": "node scripts/dep-refs.mjs",
    "verify:pre-push": "pnpm run lint && pnpm run architecture:check -- --changed",
    "build": "pnpm -r build",
    "build:desktop-agent:bytecode": "node scripts/build-desktop-agent-bytecode.mjs",
    "build:kcode": "node scripts/build-kcode.mjs",
    "build:bootstrap": "pnpm -r --filter \"./packages/*\" --filter \"!@kcode/desktop\" build && pnpm --filter @kcode/desktop build:no-runtime-assets",
    "build:sea": "pnpm --dir apps/kcode-cli build:sea",
    "build:sea:all": "pnpm install && pnpm --dir apps/kcode-cli build:sea",
    "build:native-search": "node scripts/build-native-search-tools.mjs",
    "pack:native-search": "node scripts/package-native-search-tools.mjs",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -b packages/rpc packages/provider packages/provider-node packages/shared packages/services packages/client packages/server packages/kcode-server-cli packages/ui packages/web packages/desktop/tsconfig.host.json && pnpm --filter @kcode/website typecheck",
    "bundle:desktop": "pnpm --filter @kcode/desktop run bundle --",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "knip": "knip",
    "count-lines": "bash scripts/count-lines.sh",
    "prepare:remote-assets": "pnpm --filter @kcode/desktop prepare:remote-assets",
    "doctor:macos-release": "bash scripts/doctor-macos-release-app.sh",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix --fix-suggestions",
    "bootstrap": "node scripts/bootstrap.mjs",
    "bootstrap:with-remote": "node scripts/bootstrap.mjs --with-remote",
    "release": "release-it",
    "release:cli": "pnpm --dir apps/kcode-cli run release",
    "release:cli:dry": "pnpm --dir apps/kcode-cli run release:dry",
    "architecture:check": "node scripts/architecture/architecture-check.mjs check",
    "architecture:report": "node scripts/architecture/architecture-check.mjs report",
    "architecture:baseline:update": "node scripts/architecture/architecture-check.mjs baseline:update",
    "architecture:context": "node scripts/architecture/architecture-check.mjs context"
  },
  "dependencies": {
    "border-beam": "^1.0.1",
    "d3-path": "^3.1.0",
    "tailwind-scrollbar-hide": "^4.0.0"
  },
  "devDependencies": {
    "@release-it/conventional-changelog": "^10.0.6",
    "@tanstack/react-virtual": "^3.13.23",
    "@types/node": "^25.5.0",
    "concurrently": "^9.1.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "conventional-changelog-writer": "^8.4.0",
    "dotenv": "^17.4.2",
    "husky": "^9.1.7",
    "istanbul-lib-instrument": "6.0.3",
    "knip": "^6.0.6",
    "lint-staged": "^17.0.8",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.57.0",
    "postject": "1.0.0-alpha.6",
    "release-it": "^19.2.4",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.4",
    "turbo": "^2.4.0",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "@tanstack/react-virtual": "^3.13.23"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "react": "19.2.7",
      "react-dom": "19.2.7"
    },
    "patchedDependencies": {
      "@arms/rum-electron@0.0.3": "patches/@arms__rum-electron@0.0.3.patch",
      "@ai-sdk/openai-compatible@2.0.60": "patches/@ai-sdk__openai-compatible@2.0.60.patch",
      "@ai-sdk/anthropic@3.0.81": "patches/@ai-sdk__anthropic@3.0.81.patch"
    }
  }
}
