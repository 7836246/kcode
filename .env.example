# 可选覆盖。按需复制到未跟踪的 .env 或 .env.local。
# 官方智谱 / Z.ai / BigModel OAuth 与套餐地址已移除，不要再写 ZAI_OAUTH_* 或 BIGMODEL_API_BASE_URL。

# 会话分享等仍可读的通用 endpoint；不填则用代码默认值。
KCODE_BASE_URL=
KCODE_ENDPOINT_ORIGIN=

# 导入会话的来源回链 base，不改变 API；保留 /cn/share，不含分享码。
# 修改 API origin 时同步修改此值，或删除此项以自动跟随 API origin；不要赋空值。
KCODE_CONVERSATION_SHARE_WEB_URL=

# 远程资源完整覆盖地址，必须包含与运行版本匹配的版本号；删除此项可自动按版本推导。
KCODE_CDN_BASE_URL=
KCODE_REMOTE_ASSET_CDN_BASE_URL=

# 可选本地 Provider 配置文件路径；留空使用仓库内置配置。
KCODE_BUILTIN_PROVIDER_CONFIG_FILE=

# 内网或私有部署地址没有默认值，按需显式填写。
KCODE_DEPS_BASE_URL=
INTRANET_MACHINE_HOST=
KCODE_DIST_BASE_URL=
